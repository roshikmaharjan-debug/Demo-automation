# Copy to .env and fill in. Restful Booker values are in the task brief.
API_BASE_URL=
API_USERNAME=
API_PASSWORD=

# ---- evaire / Eclat login suite (tests/evaire) ----
EVAIRE_BASE_URL=https://login.qa.evaire.ai
EVAIRE_API_BASE_URL=https://api.login.qa.evaire.ai
# Main QA account (defaults to Manager in tests/data/userCredentials.json)
EVAIRE_USERNAME=
EVAIRE_PASSWORD=
# The account's email address (needed by TC-011)
EVAIRE_EMAIL=

# QA accepts a fixed OTP for every account
OTP_CODE=000000
# Code TC-016 submits as the "wrong" OTP (must differ from OTP_CODE)
OTP_WRONG_CODE=111111

# Opt-in cases: TC-013 (lockout) and TC-022 (ends other session)
RUN_DESTRUCTIVE=0
LOCKOUT_USERNAME=
LOCKOUT_PASSWORD=
LOCKOUT_THRESHOLD=
LOCKOUT_DURATION_SEC=
LOCKOUT_MESSAGE_PATTERN=lock|too many|try again later
