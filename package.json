{
  "name": "playwright-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright Test + TypeScript suites for SauceDemo (UI), Restful Booker (API) and the evaire Eclat login (UI).",
  "scripts": {
    "test": "playwright test",
    "seed": "tsx scripts/seed-db.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:evaire": "playwright test --project=evaire",
    "test:saucedemo": "playwright test --project=saucedemo",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "engines": {
    "node": ">=20.12"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1"
  }
}
